{
  "version": "1.0.0",
  "domains": {
    "self-harm": {
      "label": "self-harm, suicide, eating disorders or a crisis",
      "stakeholder": "the person in crisis and a trained crisis professional",
      "phrases": [
        "hurt myself",
        "harm myself",
        "want to die",
        "not want to be here",
        "no reason to live",
        "starve myself",
        "binge and purge",
        "took my own life",
        "better off dead",
        "self hurting"
      ],
      "strong": [
        "suicide",
        "suicidal",
        "kill myself",
        "self-harm",
        "self harm",
        "eating disorder",
        "crisis hotline",
        "cutting myself",
        "end my life",
        "overdose"
      ],
      "patterns": [
        { "pattern": "\\b(?:want|wanted|planning|plan)\\s+to\\s+die\\b", "weight": 0.5 },
        {
          "pattern": "\\b(?:lose|lost)\\s+(?:the\\s+)?(?:will|reason)\\s+to\\s+live\\b",
          "weight": 0.5
        }
      ],
      "thresholds": {
        "sycophancy": 0.3,
        "professionalDisplacement": 0.3,
        "scopeDrift": 0.3
      }
    },
