    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/client": "2.2.0",
    "@types/node": "^24.3.0",
    "bun-types": "^1.4.4",
    "typescript": "^5.9.2"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
