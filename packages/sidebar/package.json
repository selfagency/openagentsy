    "build": "bun run scripts/build.mjs && tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@openagentsy/core": "workspace:^",
    "@openagentsy/footprint": "workspace:^",
    "@openagentsy/hooks": "workspace:^",
