{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "declarationDir": "types",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "types": ["node", "bun-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    { "path": "../core" },
    { "path": "../footprint" },
    { "path": "../hooks" },
    { "path": "../ledger" },
    { "path": "../memory" },
    { "path": "../tasks" }
  ]
}
