{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "1password": {
      "enabled": false
    },
    "beeper": {
      "enabled": false
    },
    "chrome-devtools": {
      "enabled": false
    },
    "docker": {
      "enabled": false
    },
    "git": {
      "enabled": false
    },
    "github": {
      "enabled": false
    },
    "langwatch": {
      "type": "remote",
      "url": "https://app.langwatch.ai/mcp",
      "enabled": false
    },
    "fallow": {
      "type": "local",
      "command": ["bunx", "fallow-mcp"],
      "enabled": true
    }
  }
}