{
  "name": "openagentsy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --sequential build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b",
    "ci:check": "biome ci . && pnpm typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=coverage",
    "test:watch": "vitest",
    "openagentsy": "node packages/cli/dist/index.js",
    "pretest": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fallow": "^3.34.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
