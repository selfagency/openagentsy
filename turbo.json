{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "scripts/**", "package.json", "tsconfig*.json"],
      "outputs": ["dist/**", "plugin/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "fixtures/**"],
      "outputs": [],
      "env": ["OPENAGENTSY_EVAL", "OPENAGENTSY_EVAL_MODEL", "OPENAGENTSY_EVAL_JUDGE_MODEL"]
    },
    "//#lint": {
      "inputs": ["**/*.{ts,tsx,js,mjs,json,jsonc,css}", "biome.jsonc"],
      "outputs": []
    }
  },
  "globalDependencies": ["biome.jsonc", "tsconfig.base.json", "bunfig.toml"]
}
