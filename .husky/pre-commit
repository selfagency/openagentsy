pnpm exec lint-staged
pnpm typecheck
# The changed-code gate. HEAD is the base because the staged changes sit on
# top of it, so only what this commit introduces can fail the gate.
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  pnpm exec fallow audit --base HEAD --format human --quiet
else
  pnpm exec fallow audit --base develop --format human --quiet
fi
